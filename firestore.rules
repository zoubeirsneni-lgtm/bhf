rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEBBA Healthy Food - Production Security Rules
    // Gestion complète du cycle de vie des données (création, mise à jour, suppression et consultation)

    // 1. Métadonnées système et compteurs
    match /meta/system {
      allow read, write: if true;
    }

    match /meta/counters {
      allow read, write: if true;
    }

    // 2. Clés d'idempotence
    match /orderIdempotencyKeys/{key} {
      allow read, delete: if true;
      allow create, update: if 'key' in request.resource.data
                            && 'orderId' in request.resource.data
                            && 'callerId' in request.resource.data;
    }

    // 3. Commandes
    match /orders/{orderId} {
      allow read, delete: if true;
      allow create, update: if 'id' in request.resource.data
                            && 'orderNumber' in request.resource.data
                            && 'status' in request.resource.data;
    }

    // 4. Mouvements de stock
    match /stockMovements/{movementId} {
      allow read, delete: if true;
      allow create, update: if 'ingredientId' in request.resource.data
                            && 'type' in request.resource.data;
    }

    // 5. Ingrédients & Stock
    match /ingredients/{ingredientId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    // 6. Index téléphone client
    match /clientPhoneIndex/{phone} {
      allow read, delete: if true;
      allow create, update: if 'userId' in request.resource.data;
    }

    // 7. Catalogue produit (catégories, produits, suppléments, fournisseurs)
    match /categories/{categoryId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    match /products/{productId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    match /supplements/{supplementId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    match /suppliers/{supplierId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    // 8. Utilisateurs & Livreurs
    match /users/{userId} {
      allow read, delete: if true;
      allow create, update: if 'role' in request.resource.data;
    }

    match /drivers/{driverId} {
      allow read, delete: if true;
      allow create, update: if 'name' in request.resource.data;
    }

    // Verrouillage par défaut pour toute autre collection imprévue
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
