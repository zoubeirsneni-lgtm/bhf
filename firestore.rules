rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEBBA Healthy Food - « Vos Plats santé en un clic »
    // Règles de sécurité Firestore durcies - Bloc 1B
    // 1. Zéro suppression directe (allow delete: if false sur l'ensemble de la base)
    // 2. Protection contre le contournement d'Express : validation de schéma stricte, statuts contrôlés, non-altérabilité des clés et montants
    // 3. Alignement métier du statut de paiement : paymentStatus == 'to_collect' à la création, et transitions valides ('to_collect' -> 'paid' sur livraison)
    // 4. Immutabilité des historiques d'audit (stockMovements) et clés d'idempotence (orderIdempotencyKeys)
    // 5. Catalogue public en lecture seule (categories, products, supplements)

    // 1. Métadonnées système et compteurs
    match /meta/system {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['state', 'updatedAt'])
                            && request.resource.data.state in ['READY', 'NOT_STARTED', 'MAINTENANCE'];
    }

    match /meta/counters {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['nextOrderSeq', 'updatedAt'])
                            && request.resource.data.nextOrderSeq is int
                            && request.resource.data.nextOrderSeq >= 1000;
    }

    // 2. Clés d'idempotence (Immutables et non-supprimables)
    match /orderIdempotencyKeys/{key} {
      allow read: if true;
      allow delete: if false;
      allow update: if false;
      allow create: if request.resource.data.keys().hasAll(['key', 'orderId', 'callerId', 'createdAt'])
                    && request.resource.data.key is string
                    && request.resource.data.orderId is string
                    && request.resource.data.callerId is string;
    }

    // 3. Commandes (Cycle de vie strict, paymentStatus: 'to_collect', interdiction de modification du montant ou identifiant)
    match /orders/{orderId} {
      allow read: if true;
      allow delete: if false;
      allow create: if request.resource.data.keys().hasAll([
                      'id', 'orderNumber', 'status', 'paymentStatus',
                      'items', 'totalAmount', 'createdAt', 'client'
                    ])
                    && request.resource.data.id is string
                    && request.resource.data.orderNumber is string
                    && request.resource.data.status == 'received'
                    && request.resource.data.paymentStatus == 'to_collect'
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0
                    && request.resource.data.client.name is string
                    && request.resource.data.client.phone is string
                    && request.resource.data.client.deliveryAddress is string;
      allow update: if request.resource.data.keys().hasAll(['id', 'orderNumber', 'status', 'paymentStatus'])
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.orderNumber == resource.data.orderNumber
                    && request.resource.data.totalAmount == resource.data.totalAmount
                    && request.resource.data.status in [
                      'received', 'preparing', 'ready',
                      'waiting_for_driver', 'delivering', 'delivered', 'cancelled'
                    ]
                    && request.resource.data.paymentStatus in ['to_collect', 'paid']
                    && (request.resource.data.paymentStatus == resource.data.paymentStatus
                        || (request.resource.data.paymentStatus == 'paid'
                            && (resource.data.status == 'delivered' || request.resource.data.status == 'delivered')));
    }

    // 4. Mouvements de stock (Journal d'audit immuable : ni mise à jour, ni suppression)
    match /stockMovements/{movementId} {
      allow read: if true;
      allow delete: if false;
      allow update: if false;
      allow create: if request.resource.data.keys().hasAll(['id', 'ingredientId', 'type', 'quantity', 'timestamp'])
                    && request.resource.data.type in [
                      'order_consumption', 'manual_in', 'manual_out',
                      'waste', 'inventory_correction', 'manual_adjustment',
                      'order_cancellation_restore', 'replenishment'
                    ]
                    && request.resource.data.quantity is number;
    }

    // 5. Ingrédients & Stock (Stock positif obligatoire, purchaseCost positif, pas de suppression)
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll([
                              'id', 'name', 'unit', 'currentStock',
                              'minThreshold', 'purchaseCost'
                            ])
                            && request.resource.data.currentStock is number
                            && request.resource.data.currentStock >= 0
                            && request.resource.data.name is string
                            && request.resource.data.purchaseCost is number
                            && request.resource.data.purchaseCost >= 0;
    }

    // 6. Index téléphone client (Pas de suppression publique)
    match /clientPhoneIndex/{phone} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['userId', 'phone'])
                            && request.resource.data.userId is string
                            && request.resource.data.phone is string;
    }

    // 7. Catalogue produit public (Lecture publique, modifications contrôlées, pas de suppression)
    match /categories/{categoryId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'price', 'categoryId'])
                            && request.resource.data.price is number
                            && request.resource.data.price >= 0
                            && request.resource.data.name is string;
    }

    match /supplements/{supplementId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'price'])
                            && request.resource.data.price is number
                            && request.resource.data.price >= 0;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name'])
                            && request.resource.data.name is string;
    }

    // 8. Utilisateurs (Anti-élévation de privilèges, pas de suppression directe)
    match /users/{userId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'role', 'active', 'createdAt'])
                            && request.resource.data.role in ['admin', 'kitchen', 'driver', 'client']
                            && request.resource.data.id is string
                            && request.resource.data.active is bool
                            && (!exists(/databases/$(database)/documents/users/$(userId))
                                || request.resource.data.role == resource.data.role);
    }

    // 9. Livreurs (Pas de suppression directe)
    match /drivers/{driverId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'phone', 'active'])
                            && request.resource.data.id is string
                            && request.resource.data.name is string
                            && request.resource.data.phone is string
                            && request.resource.data.active is bool;
    }

    // Verrouillage par défaut pour toute autre collection imprévue
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
