rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEBBA Healthy Food — Règles de sécurité durcies
    // 1. Aucune lecture publique des données internes
    // 2. Aucune écriture publique contournant le RBAC Express
    // 3. Accès selon rôle : client, kitchen, driver, admin, admin_readonly
    // 4. Super Admin (custom claim admin=true) : accès complet
    // 5. Suivi public via Express API (pas d'accès direct Firestore)
    // 6. Suppression interdite partout (allow delete: if false)

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isAdminReadonly() {
      return isAuthenticated() && request.auth.token.role == 'admin_readonly';
    }

    function isKitchen() {
      return isAuthenticated() && request.auth.token.role == 'kitchen';
    }

    function isDriver() {
      return isAuthenticated() && request.auth.token.role == 'driver';
    }

    function isClient() {
      return isAuthenticated() && request.auth.token.role == 'client';
    }

    function isStaff() {
      return isAdmin() || isKitchen() || isDriver();
    }

    function isOwnUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnClientPhoneIndex(phone) {
      return isAuthenticated() && request.auth.token.phone == phone;
    }

    function isOwnOrder(order) {
      return isClient() && order.clientId == request.auth.uid;
    }

    function isAssignedDriver(order) {
      return isDriver() && order.assignedDriverId == request.auth.token.driverId;
    }

    function canReadOrder(order) {
      return isAdmin()
        || isKitchen()
        || isAssignedDriver(order)
        || isOwnOrder(order);
    }

    function canUpdateOrderStatus(order, newStatus) {
      return isAdmin()
        || (isKitchen() && order.status in ['received', 'preparing'] && newStatus in ['preparing', 'ready', 'cancelled'])
        || (isAssignedDriver(order) && order.status == 'delivering' && newStatus == 'delivered');
    }

    function canUpdatePaymentStatus(order, newPaymentStatus) {
      return (isAdmin() || isAssignedDriver(order))
        && newPaymentStatus in ['to_collect', 'paid']
        && (newPaymentStatus == order.paymentStatus
            || (newPaymentStatus == 'paid' && order.status == 'delivered'));
    }

    function canManageIngredients() {
      return isAdmin() || isKitchen();
    }

    function canManageStockMovements() {
      return isAdmin();
    }

    function canManageDrivers() {
      return isAdmin();
    }

    function canManageUsers() {
      return isAdmin();
    }

    function canManageCatalog() {
      return isAdmin();
    }

    function canManageSystemMeta() {
      return isAdmin();
    }

    // 1. Métadonnées système et compteurs (Admin seulement)
    match /meta/system {
      allow read: if canManageSystemMeta();
      allow delete: if false;
      allow create, update: if canManageSystemMeta()
        && request.resource.data.keys().hasAll(['state', 'updatedAt'])
        && request.resource.data.state in ['READY', 'NOT_STARTED', 'MAINTENANCE'];
    }

    match /meta/counters {
      allow read: if canManageSystemMeta();
      allow delete: if false;
      allow create, update: if canManageSystemMeta()
        && request.resource.data.keys().hasAll(['nextOrderSeq', 'updatedAt'])
        && request.resource.data.nextOrderSeq is int
        && request.resource.data.nextOrderSeq >= 1000;
    }

    // 2. Clés d'idempotence (Création publique via Express, lecture Admin, immuables)
    match /orderIdempotencyKeys/{key} {
      allow read: if isAdmin();
      allow delete: if false;
      allow update: if false;
      allow create: if request.resource.data.keys().hasAll(['key', 'orderId', 'callerId', 'createdAt'])
                    && request.resource.data.key is string
                    && request.resource.data.orderId is string
                    && request.resource.data.callerId is string;
    }

    // 3. Commandes (Cycle de vie strict, paymentStatus: 'to_collect')
    match /orders/{orderId} {
      // Lecture : Admin voit tout, Kitchen voit tout sauf annulées, Driver ses commandes assignées, Client ses propres commandes
      allow read: if isAdmin()
        || (isKitchen() && resource.data.status != 'cancelled')
        || isAssignedDriver(resource.data)
        || isOwnOrder(resource.data);

      // Création publique (guest/client via Express) : validation stricte du schéma
      allow create: if request.resource.data.keys().hasAll([
                        'id', 'orderNumber', 'status', 'paymentStatus',
                        'items', 'totalAmount', 'createdAt', 'client'
                      ])
                      && request.resource.data.id is string
                      && request.resource.data.orderNumber is string
                      && request.resource.data.status == 'received'
                      && request.resource.data.paymentStatus == 'to_collect'
                      && request.resource.data.totalAmount is number
                      && request.resource.data.totalAmount >= 0
                      && request.resource.data.client.name is string
                      && request.resource.data.client.phone is string
                      && request.resource.data.client.deliveryAddress is string;

      // Mise à jour : transitions de statut contrôlées, montant et identifiant immuables
      allow update: if request.resource.data.keys().hasAll(['id', 'orderNumber', 'status', 'paymentStatus'])
                      && request.resource.data.id == resource.data.id
                      && request.resource.data.orderNumber == resource.data.orderNumber
                      && request.resource.data.totalAmount == resource.data.totalAmount
                      && request.resource.data.status in [
                        'received', 'preparing', 'ready',
                        'waiting_for_driver', 'delivering', 'delivered', 'cancelled'
                      ]
                      && request.resource.data.paymentStatus in ['to_collect', 'paid']
                      && (
                           (isAdmin() && canUpdateOrderStatus(resource.data, request.resource.data.status)
                                && canUpdatePaymentStatus(resource.data, request.resource.data.paymentStatus))
                         || (isKitchen() && canUpdateOrderStatus(resource.data, request.resource.data.status)
                                && request.resource.data.paymentStatus == resource.data.paymentStatus)
                         || (isAssignedDriver(resource.data) && canUpdateOrderStatus(resource.data, request.resource.data.status)
                                && canUpdatePaymentStatus(resource.data, request.resource.data.paymentStatus))
                         )
                      && (request.resource.data.paymentStatus == resource.data.paymentStatus
                          || (request.resource.data.paymentStatus == 'paid'
                              && (resource.data.status == 'delivered' || request.resource.data.status == 'delivered')));
      allow delete: if false;
    }

    // 4. Mouvements de stock (Journal d'audit immuable)
    match /stockMovements/{movementId} {
      allow read: if canManageStockMovements();
      allow delete: if false;
      allow update: if false;
      allow create: if canManageStockMovements()
        && request.resource.data.keys().hasAll(['id', 'ingredientId', 'type', 'quantity', 'timestamp'])
        && request.resource.data.type in [
          'order_consumption', 'manual_in', 'manual_out',
          'waste', 'inventory_correction', 'manual_adjustment',
          'order_cancellation_restore', 'replenishment'
        ]
        && request.resource.data.quantity is number;
    }

    // 5. Ingrédients & Stock (Admin & Kitchen)
    match /ingredients/{ingredientId} {
      allow read: if canManageIngredients();
      allow delete: if false;
      allow create, update: if canManageIngredients()
        && request.resource.data.keys().hasAll([
            'id', 'name', 'unit', 'currentStock',
            'minThreshold', 'purchaseCost'
          ])
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock >= 0
        && request.resource.data.name is string
        && request.resource.data.purchaseCost is number
        && request.resource.data.purchaseCost >= 0;
    }

    // 6. Index téléphone client (Client lit le sien, Admin gère)
    match /clientPhoneIndex/{phone} {
      allow read: if isAdmin() || isOwnClientPhoneIndex(phone);
      allow delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['userId', 'phone'])
        && request.resource.data.userId is string
        && request.resource.data.phone is string;
    }

    // 7. Catalogue produit public (Lecture publique, écriture Admin)
    match /categories/{categoryId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if canManageCatalog()
        && request.resource.data.keys().hasAll(['id', 'name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if canManageCatalog()
        && request.resource.data.keys().hasAll(['id', 'name', 'price', 'categoryId'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.name is string;
    }

    match /supplements/{supplementId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if canManageCatalog()
        && request.resource.data.keys().hasAll(['id', 'name', 'price'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if canManageCatalog()
        && request.resource.data.keys().hasAll(['id', 'name'])
        && request.resource.data.name is string;
    }

    // 8. Utilisateurs (Anti-élévation, pas de suppression)
    match /users/{userId} {
      // Admin lit tout, utilisateur lit son propre doc
      allow read: if isAdmin() || isOwnUser(userId);
      allow delete: if false;
      // Création/MAJ : Admin seulement, pas d'élévation de privilèges
      allow create, update: if canManageUsers()
        && request.resource.data.keys().hasAll(['id', 'role', 'active', 'createdAt'])
        && request.resource.data.role in ['admin', 'kitchen', 'driver', 'client', 'admin_readonly']
        && request.resource.data.id is string
        && request.resource.data.active is bool
        && (!exists(/databases/$(database)/documents/users/$(userId))
            || request.resource.data.role == resource.data.role);
    }

    // 9. Livreurs (Admin gère, Driver lit son propre)
    match /drivers/{driverId} {
      allow read: if isAdmin() || (isDriver() && request.auth.token.driverId == driverId);
      allow delete: if false;
      allow create, update: if canManageDrivers()
        && request.resource.data.keys().hasAll(['id', 'name', 'phone', 'active'])
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.active is bool;
    }

    // Verrouillage par défaut pour toute autre collection imprévue
    match /{document=**} {
      allow read, write: if false;
    }
  }
}