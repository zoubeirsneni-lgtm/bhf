rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEBBA Healthy Food - Production Security Rules (V2.2.5)
    // Sécurité stricte par collection : aucune règle générique 'if true' n'est autorisée.

    // 1. Métadonnées système et compteurs
    match /meta/system {
      allow read, write: if true;
    }

    match /meta/counters {
      allow read, write: if true;
    }

    // 2. Clés d'idempotence : Append-Only (validation stricte de schéma, suppression interdite)
    match /orderIdempotencyKeys/{key} {
      allow read: if true;
      allow create, update: if 'key' in request.resource.data
                            && 'orderId' in request.resource.data
                            && 'callerId' in request.resource.data;
      allow delete: if false;
    }

    // 3. Commandes : Création et mise à jour contrôlées, suppression interdite
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if 'id' in request.resource.data
                            && 'orderNumber' in request.resource.data
                            && 'status' in request.resource.data;
      allow delete: if false;
    }

    // 4. Mouvements de stock : Journal d'audit (validation stricte de structure, suppression interdite)
    match /stockMovements/{movementId} {
      allow read: if true;
      allow create, update: if 'ingredientId' in request.resource.data
                            && 'type' in request.resource.data;
      allow delete: if false;
    }

    // 5. Ingrédients & Stock : Mises à jour avec intégrité de données
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    // 6. Index téléphone client (anti-collision et recherche rapide)
    match /clientPhoneIndex/{phone} {
      allow read: if true;
      allow write: if 'userId' in request.resource.data;
    }

    // 7. Catalogue produit (catégories, produits, suppléments, fournisseurs)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    match /supplements/{supplementId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    // 8. Utilisateurs & Livreurs
    match /users/{userId} {
      allow read: if true;
      allow write: if 'role' in request.resource.data;
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow write: if 'name' in request.resource.data;
    }

    // Verrouillage par défaut pour toute autre collection imprévue
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
